#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: chrome_dev [--headed] [url|host:port|/path|--stop] [-h|--help]

Launches a debug-controlled Chrome (headless by default) at an arbitrary URL, with
--remote-debugging-port wired up so the Playwright MCP (and other CDP clients)
can drive it. Chrome is left running in the background; the command returns as
soon as the debug port is ready.

Argument forms:
  https://site/...     absolute URL, opened as-is
  localhost:3100/x     scheme-less host:port[/path]  -> http://localhost:3100/x
  3100                 bare port                      -> http://localhost:3100
  /lookup              leading-slash path             -> http://localhost:<CHROME_DEV_PORT_ORIGIN>/lookup
  (omitted)            opens about:blank
  --stop               kill the chrome_dev Chrome instance and exit
  --headed             show a window (default is headless)

Env overrides:
  CHROME_DEV_PORT          Chrome --remote-debugging-port (default 9222)
  CHROME_DEV_PROFILE       Chrome --user-data-dir (default /tmp/chrome_dev_profile)
  CHROME_DEV_ORIGIN        origin used for bare "/path" args (default http://localhost:3000)
  CHROME_DEV_HEADLESS=0    show a window (default 1 = headless; --headed does the same)

Examples:
  chrome_dev https://prealgebra-diagnostic.vercel.app/lookup
  chrome_dev localhost:3100/courses/1
  chrome_dev 3100
  chrome_dev --headed localhost:5174
  chrome_dev --stop
USAGE
}

DEBUG_PORT="${CHROME_DEV_PORT:-9222}"
CHROME_PROFILE="${CHROME_DEV_PROFILE:-/tmp/chrome_dev_profile}"
DEFAULT_ORIGIN="${CHROME_DEV_ORIGIN:-http://localhost:3000}"
PID_FILE="/tmp/chrome_dev_${DEBUG_PORT}.pid"
LOG_FILE="/tmp/chrome_dev_${DEBUG_PORT}.log"

chrome_cmd() {
  for bin in google-chrome google-chrome-stable chromium-browser chromium brave-browser vivaldi; do
    if command -v "$bin" >/dev/null 2>&1; then
      printf '%s' "$bin"
      return 0
    fi
  done
  return 1
}

stop_existing() {
  local pid=""
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  fi
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..10}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.3
    done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
}

wait_for_debug_port() {
  local version_url="http://127.0.0.1:${DEBUG_PORT}/json/version"
  for _ in {1..60}; do
    if curl -fsS --max-time 1 "$version_url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  echo "Chrome debug port not ready at $version_url"
  return 1
}

normalize_url() {
  local arg="$1"
  if [ -z "$arg" ]; then
    printf 'about:blank'
  elif [[ "$arg" =~ ^https?:// ]] || [[ "$arg" == about:* ]] || [[ "$arg" == file://* ]]; then
    printf '%s' "$arg"
  elif [[ "$arg" =~ ^[0-9]+(/.*)?$ ]]; then
    # bare port, optionally with a path
    printf 'http://localhost:%s' "$arg"
  elif [[ "$arg" == /* ]]; then
    # leading-slash path on the default origin
    printf '%s%s' "${DEFAULT_ORIGIN%/}" "$arg"
  else
    # host[:port][/path] without scheme
    printf 'http://%s' "$arg"
  fi
}

HEADLESS="${CHROME_DEV_HEADLESS:-1}"
if [ "${1:-}" = "--headed" ]; then HEADLESS=0; shift; fi

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --stop) stop_existing; echo "chrome_dev stopped (port $DEBUG_PORT)."; exit 0 ;;
esac

TARGET_URL="$(normalize_url "${1:-}")"

browser_bin="$(chrome_cmd)" || { echo "No Chrome-compatible browser found"; exit 1; }

stop_existing

HEADLESS_FLAG=()
if [ "$HEADLESS" = "1" ]; then
  HEADLESS_FLAG=(--headless=new --disable-gpu)
fi

nohup "$browser_bin" \
  --no-first-run \
  --no-default-browser-check \
  --disable-session-crashed-bubble \
  --disable-popup-blocking \
  "${HEADLESS_FLAG[@]}" \
  --user-data-dir="$CHROME_PROFILE" \
  --remote-debugging-port="$DEBUG_PORT" \
  --new-window "$TARGET_URL" \
  >/dev/null 2>"$LOG_FILE" &
chrome_pid=$!
printf '%s\n' "$chrome_pid" > "$PID_FILE"

if wait_for_debug_port; then
  echo "chrome_dev running."
  echo "  Opened page:  $TARGET_URL"
  echo "  Chrome debug: http://127.0.0.1:$DEBUG_PORT  (Playwright MCP can attach here)"
  echo "  Profile:      $CHROME_PROFILE"
  echo "  Log:          $LOG_FILE"
  echo "  Stop with:    chrome_dev --stop"
else
  echo "  Chrome log: $LOG_FILE"
  exit 1
fi
