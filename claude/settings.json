{
  "promptCacheTtl": "1h",
  "autoCompactWindow": 300000,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "fileSuggestion": {
    "type": "command",
    "command": "$HOME/.claude/file-suggestion.sh"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$HOME/.claude/scripts/graphify-startup.sh" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 $HOME/.claude/scripts/cache_guard.py" } ] }
    ]
  }
}
