# Claude Code prompt-cache guard — thresholds. Read by ~/.claude/scripts/cache_*.py.
# Below this many tokens a cold rebuild is cheap; no warning, no block.
MIN_TOKENS=60000
# Minutes before cache expiry at which the "compact now while warm" nudge fires.
NUDGE_MIN=10
# 1 = when the session runs inside tmux, type /compact into it at the nudge instead of only nagging.
AUTOCOMPACT=0
# 1 = desktop popup + warning sound per alert; 0 = log only.
DESKTOP=0
# 1 = also send Telegram via a dn_alert_relay module on PATH (optional); 0 = desktop only.
TELEGRAM=0
# Minutes a blocked prompt's resend is allowed through without a second block.
ACK_MIN=5
